# Copy to .env and fill values before running non-local tasks.

# Signing key used by Hardhat for base-sepolia/base networks.
# Keep as raw hex or 0x-prefixed hex (both are accepted).
PRIVATE_KEY=

# Base RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# BaseScan API key for contract verification
ETHERSCAN_API_KEY=
